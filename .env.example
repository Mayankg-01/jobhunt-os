# JobHunt OS Configuration
# Copy this file to .env and fill in your values

# ============ AI Configuration ============
# Provider: openai, anthropic, or openrouter
JH_AI_PROVIDER=openai
JH_AI_API_KEY=your-api-key-here
JH_AI_MODEL=gpt-4o
JH_AI_TEMPERATURE=0.3
JH_AI_MAX_TOKENS=4000

# ============ Database ============
# Type: sqlite (local) or postgresql (production)
JH_DB_TYPE=sqlite
JH_DB_PATH=~/.jobhunt/jobhunt.db

# For PostgreSQL (production):
# JH_DB_TYPE=postgresql
# JH_DB_HOST=localhost
# JH_DB_PORT=5432
# JH_DB_USERNAME=jobhunt
# JH_DB_PASSWORD=your-secure-password
# JH_DB_NAME=jobhunt

# ============ LinkedIn (Optional) ============
JH_LI_ENABLED=false
JH_LI_LI_AT_COOKIE=your-li_at-cookie-from-browser
JH_LI_RATE_LIMIT_PER_HOUR=20
JH_LI_HEADLESS=true

# ============ Google Sheets (Optional) ============
JH_GOOGLE_ENABLED=false
JH_GOOGLE_CREDENTIALS_FILE=~/.jobhunt/google_credentials.json
JH_GOOGLE_TOKEN_FILE=~/.jobhunt/google_token.json
JH_GOOGLE_SHEETS_ID=your-google-sheets-id

# ============ Search Configuration ============
JH_SEARCH_SOURCES=linkedin,indeed,glassdoor,google
JH_SEARCH_RESULTS_PER_SOURCE=50
JH_SEARCH_RADIUS_KM=50
JH_SEARCH_REMOTE_ONLY=false
JH_SEARCH_DATE_POSTED_DAYS=7
JH_SEARCH_JOB_TYPES=fulltime,contract
JH_SEARCH_EXPERIENCE_LEVELS=mid,senior,lead

# ============ User Profile (Optional - can use CLI profile create) ============
JH_USER_NAME=Your Name
JH_USER_EMAIL=you@example.com
JH_USER_LOCATION=San Francisco, CA
JH_USER_LINKEDIN_URL=https://linkedin.com/in/yourprofile
JH_USER_GITHUB_URL=https://github.com/yourusername
JH_USER_PORTFOLIO_URL=https://yourportfolio.com
JH_USER_TARGET_ROLES=Software Engineer,Senior Software Engineer
JH_USER_TARGET_INDUSTRIES=Technology,FinTech,AI/ML
JH_USER_TARGET_LOCATIONS=San Francisco,Remote
JH_USER_YEARS_EXPERIENCE=5
JH_USER_VISA_STATUS=US Citizen
JH_USER_SALARY_MIN=150000
JH_USER_SALARY_MAX=300000